# Backend Environment Variables
# Copy this file to .env for local development (not needed for Docker)

# ============================================
# Server Configuration
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=portfolio_db
DB_USER=root
DB_PASSWORD=your_password_here

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ============================================
# Admin Default Credentials
# ============================================
# These credentials are used to create the default admin account
# Change these after first login!
ADMIN_EMAIL=admin@arittro.com
ADMIN_PASSWORD=admin123

# ============================================
# CORS Configuration
# ============================================
# Frontend URL for CORS - adjust for your development/production setup
FRONTEND_URL=http://localhost
