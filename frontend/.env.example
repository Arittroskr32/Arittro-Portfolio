# Frontend environment variables (all optional).
# The GitHub Pages workflow sets these automatically; you only need a .env for
# local development if your repository or branch differ from the defaults.

# Repository the admin panel commits content changes to ("owner/repo").
VITE_GITHUB_REPO=Arittroskr32/Arittro-Portfolio

# Branch the site is built from.
VITE_GITHUB_BRANCH=main
