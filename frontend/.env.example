# Frontend Environment Variables
# Copy this file to .env for local development (not needed for Docker)

# ============================================
# Backend API Configuration
# ============================================
# URL where the backend API is running
# For local development: http://localhost:5000/api
# For Docker: http://localhost:8888/api (or your configured BACKEND_PORT)
# For production: https://yourdomain.com/api
VITE_API_URL=http://localhost:8888/api
