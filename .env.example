# Docker Environment Variables
# Copy this file to .env and update with your values before running docker-compose

# ============================================
# Database Configuration
# ============================================
DB_USER=portfolio_user
DB_PASSWORD=your_secure_password_here
DB_NAME=portfolio_db
DB_PORT=3306

# ============================================
# Backend Configuration
# ============================================
BACKEND_PORT=8888
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin Default Credentials (Change after first login!)
ADMIN_EMAIL=admin@arittro.com
ADMIN_PASSWORD=admin123

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_PORT=80
FRONTEND_URL=http://localhost

# Backend API URL for frontend (used at build time)
# For Docker: use the backend service name and port
# For production: use your domain/IP
VITE_API_URL=http://localhost:8888/api

# ============================================
# Node Environment
# ============================================
NODE_ENV=production
